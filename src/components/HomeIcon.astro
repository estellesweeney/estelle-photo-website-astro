---
// Drop-in replacement for "Estelle Sweeney" nav link across all pages
---
<a href="/" class="home-icon-wrap" aria-label="Home">
  <img src="/icons/icon_16.svg" alt="" class="home-icon-img" />
  <span class="home-icon-label">home</span>
</a>

<style>
  .home-icon-wrap {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
    gap: 3px;
    line-height: 1;
  }
  .home-icon-img {
    width: 22px;
    height: 22px;
    filter: none;
    opacity: 0.9;
    transition: opacity 0.25s ease;
    display: block;
  }
  .home-icon-wrap:hover .home-icon-img {
    opacity: 0.45;
  }
  .home-icon-label {
    font-family: monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: rgba(245, 240, 232, 0.75);
    opacity: 0;
    transition: opacity 0.25s ease;
    white-space: nowrap;
  }
  .home-icon-wrap:hover .home-icon-label {
    opacity: 1;
  }
</style>

---
import Layout from "@/layouts/Layout.astro";
import HorizontalGallery from "@/components/HorizontalGallery";
import { backstageBrands } from "@/data/backstage";

export function getStaticPaths() {
  const active = backstageBrands.filter(b => b.cover);
  return active.map((b, i) => ({
    params: { brand: b.slug },
    props: {
      brand: b,
      next: active[(i + 1) % active.length],
    },
  }));
}

const { brand, next } = Astro.props;
---

<Layout title={`${brand.name} Backstage — Estelle Sweeney`}>
  <div class="min-h-screen bg-black text-white font-sans">
    {brand.images.length > 0 ? (
      <HorizontalGallery
        images={brand.images}
        alt={`${brand.name} backstage`}
        backHref="/backstage"
        backLabel="← Backstage"
        title={brand.name}
        nextHref={`/backstage/${next.slug}`}
        nextLabel={next.name}
        nextCover={next.cover}
        client:load
      />
    ) : (
      <div style="position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;background:#080808;">
        {brand.cover && <img src={brand.cover} alt={brand.name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;filter:grayscale(30%) brightness(0.35);" />}
        <div style="position:relative;z-index:2;text-align:center;padding:40px;">
          <p style="font-family:monospace;font-size:8px;letter-spacing:0.3em;text-transform:uppercase;color:rgba(245,240,232,0.35);margin-bottom:16px;">{brand.name} · {brand.season}</p>
          <p style="font-family:'Bodoni Moda',serif;font-size:clamp(24px,4vw,40px);color:rgba(245,240,232,0.85);margin-bottom:32px;letter-spacing:0.04em;">Gallery coming soon</p>
          <div style="display:flex;justify-content:center;gap:24px;flex-wrap:wrap;">
            <a href="/backstage" style="font-family:monospace;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(245,240,232,0.4);text-decoration:none;">← Backstage</a>
            <a href={`/backstage/${next.slug}`} style="font-family:monospace;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(245,240,232,0.4);text-decoration:none;">Next: {next.name} →</a>
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>

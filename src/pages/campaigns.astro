---
import HomeIcon from '@/components/HomeIcon.astro';
import Layout from "@/layouts/Layout.astro";
import CampaignHouse from "@/components/CampaignHouse";
import { CAMPAIGN_PROJECTS } from "@/data/campaigns";
---

<Layout title="Campaigns — Estelle Sweeney">
  <div class="min-h-screen bg-black text-white font-sans">

    <nav class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <HomeIcon />
      <a href="mailto:estellescreative@gmail.com" class="text-xs tracking-[0.15em] uppercase font-display hover:opacity-50 transition-opacity">Contact</a>
    </nav>

    <main class="px-4 pt-8 pb-16 max-w-[1100px] mx-auto">

      <!-- Header row -->
      <div class="flex items-end justify-between mb-10">
        <div>
          <h1 class="text-xs tracking-[0.28em] uppercase font-display mb-2">Campaigns</h1>
          <p class="text-[10px] tracking-[0.1em] text-white/30 font-display">A selection of campaign projects and collaborations.</p>
        </div>
        <a
          href="/campaigns"
          class="text-[10px] tracking-[0.18em] uppercase font-display text-white/35 hover:text-white transition-colors hidden sm:flex items-center gap-1.5"
        >
          View all projects <span class="text-sm leading-none">→</span>
        </a>
      </div>

      <!-- Dreamcast house -->
      <CampaignHouse projects={CAMPAIGN_PROJECTS} client:load />

    </main>

  </div>
</Layout>

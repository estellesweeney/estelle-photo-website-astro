---

<Layout title="Campaigns — Estelle Sweeney">
  <div class="min-h-screen bg-black text-cream font-sans">

    <nav class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <HomeIcon />
      <a href="mailto:estellescreative@gmail.com" class="text-xs tracking-[0.15em] uppercase font-display hover:opacity-50 transition-opacity">Contact</a>
    </nav>

    <main class="px-4 py-10 max-w-6xl mx-auto">
      <h1 class="text-xs tracking-[0.25em] uppercase font-display pb-6 border-b border-white/10 mb-8">Campaigns</h1>

      <div class="campaign-grid">
        {images.map((img, i) => (
          <div class="campaign-item">
            <img
              src={img.src}
              alt={img.alt}
              loading={i < 4 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </main>

  </div>
</Layout>

<style>
  .campaign-grid {
    columns: 3;
    column-gap: 6px;
  }

  .campaign-item {
    break-inside: avoid;
    margin-bottom: 6px;
    overflow: hidden;
  }

  .campaign-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.4s ease;
  }

  .campaign-item:hover img {
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .campaign-grid {
      columns: 2;
      column-gap: 4px;
    }
    .campaign-item {
      margin-bottom: 4px;
    }
  }

  @media (max-width: 480px) {
    .campaign-grid {
      columns: 1;
    }
  }
</style>

---
import Layout from "@/layouts/Layout.astro";
import GalleryLightbox from "@/components/GalleryLightbox";
import { runwayShows } from "@/data/runway";

export function getStaticPaths() {
  return runwayShows.map((show) => ({
    params: { brand: show.slug },
  }));
}

const { brand } = Astro.params;
const show = runwayShows.find((s) => s.slug === brand);
if (!show) return Astro.redirect("/runway");
---

<Layout title={`${show.brand} — Runway — Estelle Sweeney`}>
  <div class="min-h-screen bg-black text-cream">

    <nav class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <a href="/" class="text-sm font-semibold tracking-[0.2em] uppercase font-display hover:opacity-50 transition-opacity">Estelle Sweeney</a>
      <a href="mailto:estellescreative@gmail.com" class="text-xs tracking-[0.15em] uppercase font-display hover:opacity-50 transition-opacity">Contact</a>
    </nav>

    <main>
      {/* Header */}
      <div class="px-6 py-8 border-b border-white/10 flex items-baseline justify-between">
        <div class="flex flex-col gap-1">
          <a href="/runway" class="text-[10px] tracking-[0.2em] uppercase text-white/30 hover:text-white/60 transition-colors font-display mb-2">← Runway</a>
          <h1 class="text-sm tracking-[0.2em] uppercase font-display">{show.brand}</h1>
        </div>
        <span class="text-xs tracking-wider text-white/40 uppercase">{show.season}</span>
      </div>

      {/* Gallery */}
      <GalleryLightbox images={show.images} alt={show.brand} client:load />
    </main>

  </div>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import HorizontalGallery from "@/components/HorizontalGallery";
import { runwayShows } from "@/data/runway";

export function getStaticPaths() {
  return runwayShows.map((show, i) => ({
    params: { brand: show.slug },
    props: {
      show,
      next: runwayShows[(i + 1) % runwayShows.length],
    },
  }));
}

const { show, next } = Astro.props;
---

<Layout title={`${show.brand} — Runway — Estelle Sweeney`}>
  <div class="min-h-screen bg-black text-white">
    {show.images.length > 0 ? (
      <HorizontalGallery
        images={show.images}
        alt={`${show.brand} runway`}
        backHref="/runway"
        backLabel="← Runway"
        title={show.brand}
        nextHref={`/runway/${next.slug}`}
        nextLabel={next.brand}
        nextCover={next.cover}
        client:load
      />
    ) : (
      <div style="position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;background:#080808;">
        {show.cover && <img src={show.cover} alt={show.brand} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(0.3);" />}
        <div style="position:relative;z-index:2;text-align:center;padding:40px;">
          <p style="font-family:monospace;font-size:8px;letter-spacing:0.3em;text-transform:uppercase;color:rgba(245,240,232,0.35);margin-bottom:16px;">{show.brand} · {show.season}</p>
          <p style="font-family:'Bodoni Moda',serif;font-size:clamp(24px,4vw,40px);color:rgba(245,240,232,0.85);margin-bottom:32px;">Gallery coming soon</p>
          <a href="/runway" style="font-family:monospace;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(245,240,232,0.4);text-decoration:none;">← Runway</a>
        </div>
      </div>
    )}
  </div>
</Layout>

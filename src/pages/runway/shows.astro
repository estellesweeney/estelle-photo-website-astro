---
import Layout from "@/layouts/Layout.astro";
import { runwayShows } from "@/data/runway";

// Shows with galleries — shown as filmstrips
const galleryShows = runwayShows.map((s, i) => ({
  index: i + 1,
  slug: s.slug,
  brand: s.brand,
  season: s.season,
  // Take first 4 images for the filmstrip preview
  strip: Array.from({ length: 4 }, (_, j) => s.images[j] ?? null),
}));

// All shows (text index at bottom)
const allShows = [
  { brand: "Walter Van Bierendonck",      season: "PFW 2026",  slug: "walter-van-bierendonck" },
  { brand: "KidSuper AW26/27",            season: "PFW 2026",  slug: "kidsuper-aw2627" },
  { brand: "KidSuper AW25",               season: "PFW 2025",  slug: "kidsuper-aw25" },
  { brand: "Science Project",             season: "PFW 2026",  slug: null },
  { brand: "Campillo AW26/27",            season: "PFW 2026",  slug: null },
  { brand: "Yuima Nakazato",              season: "PFW 2026",  slug: null },
  { brand: "Grace Ling AW26",             season: "NYFW 2026", slug: null },
  { brand: "Mugler AW25",                 season: "PFW 2025",  slug: null },
  { brand: "Rick Owens SS24",             season: "PFW 2024",  slug: null },
  { brand: "Mugler SS24",                 season: "PFW 2024",  slug: null },
  { brand: "Louis De Javier AW25",        season: "PFW 2025",  slug: null },
  { brand: "Tombogo AW25",                season: "NYFW 2025", slug: null },
  { brand: "Ruibuilt AW25",               season: "PFW 2025",  slug: null },
  { brand: "Paula Casanova Del Vas AW25", season: "PFW 2025",  slug: null },
  { brand: "Hold NYC AW25",               season: "NYFW 2025", slug: null },
  { brand: "Franck Sorbier — Couture",    season: "PFW 2024",  slug: null },
  { brand: "Namesak3 SS26",               season: "NYFW 2025", slug: null },
  { brand: "3.Paradis SS25",              season: "PFW 2025",  slug: null },
  { brand: "Vivienne Westwood AW25",      season: "PFW 2025",  slug: null },
  { brand: "Rhude AW24",                  season: "NYFW 2024", slug: null },
];
---

<Layout title="Runway — Estelle Sweeney">
  <div class="min-h-screen bg-black text-cream">

    <nav class="flex items-center justify-between px-8 py-6 border-b border-white/10">
      <a href="/" class="text-sm font-semibold tracking-[0.2em] uppercase font-display hover:opacity-50 transition-opacity">
        Estelle Sweeney
      </a>
      <a href="mailto:estellescreative@gmail.com" class="text-xs tracking-[0.15em] uppercase font-display hover:opacity-50 transition-opacity">
        Contact
      </a>
    </nav>

    <main class="px-8 py-14 max-w-screen-xl mx-auto">

      {/* Page header */}
      <div class="mb-14 pb-6 border-b border-white/10">
        <h1 class="text-xs tracking-[0.35em] uppercase font-display text-white/50">Runway</h1>
      </div>

      {/* Filmstrip grid — one row per show */}
      <div class="flex flex-col gap-12 mb-24">
        {galleryShows.map((show) => (
          <a href={`/runway/${show.slug}`} class="group block cursor-pointer">

            {/* 4-image horizontal strip */}
            <div class="grid grid-cols-4 gap-[2px] mb-4">
              {show.strip.map((src, j) => (
                <div class="w-full overflow-hidden" style="aspect-ratio: 4/3;">
                  {src ? (
                    <img
                      src={src}
                      alt={show.brand}
                      class="w-full h-full object-contain transition-opacity duration-400 group-hover:opacity-70"
                      loading="lazy"
                      draggable={false}
                    />
                  ) : (
                    <div class="w-full h-full bg-white/[0.03] border border-white/[0.07]" />
                  )}
                </div>
              ))}
            </div>

            {/* Caption */}
            <div class="flex items-baseline gap-5">
              <span class="text-[11px] text-white/25 tabular-nums" style="font-family: Arial, sans-serif;">
                {String(show.index).padStart(3, "0")}
              </span>
              <span class="text-sm font-display tracking-wide group-hover:opacity-50 transition-opacity">
                {show.brand}
              </span>
              <span class="text-xs tracking-[0.15em] uppercase text-white/30" style="font-family: Arial, sans-serif;">
                {show.season}
              </span>
            </div>

          </a>
        ))}
      </div>

      {/* Full numbered index */}
      <div class="border-t border-white/10 pt-14">
        <ol class="flex flex-col divide-y divide-white/[0.07]">
          {allShows.map((show, i) => (
            <li>
              {show.slug ? (
                <a
                  href={`/runway/${show.slug}`}
                  class="group flex items-baseline gap-5 py-4 hover:opacity-60 transition-opacity"
                >
                  <span class="text-[11px] text-white/25 tabular-nums shrink-0 w-8" style="font-family: Arial, sans-serif;">
                    {String(i + 1).padStart(3, "0")}
                  </span>
                  <span class="text-sm font-display tracking-wide">{show.brand}</span>
                  <span class="text-xs tracking-[0.15em] uppercase text-white/30 ml-auto shrink-0" style="font-family: Arial, sans-serif;">
                    {show.season}
                  </span>
                </a>
              ) : (
                <div class="flex items-baseline gap-5 py-4 opacity-40">
                  <span class="text-[11px] text-white/25 tabular-nums shrink-0 w-8" style="font-family: Arial, sans-serif;">
                    {String(i + 1).padStart(3, "0")}
                  </span>
                  <span class="text-sm font-display tracking-wide">{show.brand}</span>
                  <span class="text-xs tracking-[0.15em] uppercase text-white/30 ml-auto shrink-0" style="font-family: Arial, sans-serif;">
                    {show.season}
                  </span>
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>

    </main>
  </div>
</Layout>

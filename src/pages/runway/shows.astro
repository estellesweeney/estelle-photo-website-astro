---
import Layout from "@/layouts/Layout.astro";
import { runwayShows } from "@/data/runway";

const featured = runwayShows.map((s) => ({
  slug: s.slug,
  brand: s.brand,
  season: s.season,
  cover: s.cover,
}));

const credits = [
  { brand: "Science Project",             season: "PFW 2026" },
  { brand: "Campillo AW26/27",            season: "PFW 2026" },
  { brand: "Yuima Nakazato",              season: "PFW 2026" },
  { brand: "Grace Ling AW26",             season: "NYFW 2026" },
  { brand: "Mugler AW25",                 season: "PFW 2025" },
  { brand: "Rick Owens SS24",             season: "PFW 2024" },
  { brand: "Mugler SS24",                 season: "PFW 2024" },
  { brand: "Louis De Javier AW25",        season: "PFW 2025" },
  { brand: "Tombogo AW25",                season: "NYFW 2025" },
  { brand: "Ruibuilt AW25",               season: "PFW 2025" },
  { brand: "Paula Casanova Del Vas AW25", season: "PFW 2025" },
  { brand: "Hold NYC AW25",               season: "NYFW 2025" },
  { brand: "Franck Sorbier — Couture",    season: "PFW 2024" },
  { brand: "Namesak3 SS26",               season: "NYFW 2025" },
  { brand: "3.Paradis SS25",              season: "PFW 2025" },
  { brand: "Vivienne Westwood AW25",      season: "PFW 2025" },
  { brand: "Rhude AW24",                  season: "NYFW 2024" },
];
---

<Layout title="Runway — Estelle Sweeney">
  <div class="min-h-screen bg-black text-cream">

    {/* Nav */}
    <nav class="flex items-center justify-between px-8 py-6 border-b border-white/10">
      <a href="/" class="text-sm font-semibold tracking-[0.2em] uppercase font-display hover:opacity-50 transition-opacity">
        Estelle Sweeney
      </a>
      <a href="mailto:estellescreative@gmail.com" class="text-xs tracking-[0.15em] uppercase font-display hover:opacity-50 transition-opacity">
        Contact
      </a>
    </nav>

    <main class="px-8 py-16 max-w-screen-xl mx-auto">

      {/* Page title */}
      <div class="mb-16 pb-6 border-b border-white/10">
        <h1 class="text-xs tracking-[0.35em] uppercase font-display text-white/50">Runway</h1>
      </div>

      {/* Featured shows — 2 col grid like Goodman */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16 mb-24">
        {featured.map((show) => (
          <a
            href={`/runway/${show.slug}`}
            class="group block cursor-pointer"
          >
            {/* Image */}
            <div class="w-full overflow-hidden mb-5" style="aspect-ratio: 4/3;">
              <img
                src={show.cover}
                alt={show.brand}
                class="w-full h-full object-cover transition-opacity duration-500 group-hover:opacity-70"
                loading="lazy"
              />
            </div>

            {/* Caption — Goodman style */}
            <div class="flex flex-col gap-1.5">
              <p class="text-base font-display tracking-wide group-hover:opacity-60 transition-opacity">
                {show.brand}
              </p>
              <p class="text-xs tracking-[0.2em] uppercase text-white/40" style="font-family: Arial, sans-serif;">
                {show.season}
              </p>
            </div>
          </a>
        ))}
      </div>

      {/* Selected Credits — smaller grid */}
      <div class="border-t border-white/10 pt-16">
        <h2 class="text-[10px] tracking-[0.35em] uppercase text-white/25 font-display mb-12">
          Selected Credits
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-0">
          {credits.map((show) => (
            <div class="py-5 border-b border-white/10 flex flex-col gap-1">
              <p class="text-sm font-display text-white/70 tracking-wide">{show.brand}</p>
              <p class="text-[11px] tracking-[0.2em] uppercase text-white/30" style="font-family: Arial, sans-serif;">
                {show.season}
              </p>
            </div>
          ))}
        </div>
      </div>

    </main>
  </div>
</Layout>

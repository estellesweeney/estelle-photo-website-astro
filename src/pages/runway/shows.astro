---
import Layout from "@/layouts/Layout.astro";
import { runwayShows } from "@/data/runway";

// Shows with full galleries
const galleryShows = runwayShows.map((s) => ({
  slug: s.slug,
  brand: s.brand,
  season: s.season,
  cover: s.cover,
  hasGallery: true,
}));

// Shows listed but no gallery yet
const textOnlyShows = [
  { brand: "Science Project",           season: "PFW 2026" },
  { brand: "Campillo AW26/27",          season: "PFW 2026" },
  { brand: "Yuima Nakazato",            season: "PFW 2026" },
  { brand: "Grace Ling AW26",           season: "NYFW 2026" },
  { brand: "Mugler AW25",               season: "PFW 2025" },
  { brand: "Rick Owens SS24",           season: "PFW 2024" },
  { brand: "Mugler SS24",               season: "PFW 2024" },
  { brand: "Louis De Javier AW25",      season: "PFW 2025" },
  { brand: "Tombogo AW25",              season: "NYFW 2025" },
  { brand: "Ruibuilt AW25",             season: "PFW 2025" },
  { brand: "Paula Casanova Del Vas AW25", season: "PFW 2025" },
  { brand: "Hold NYC AW25",             season: "NYFW 2025" },
  { brand: "Franck Sorbier — Couture",  season: "PFW 2024" },
  { brand: "Namesak3 SS26",             season: "NYFW 2025" },
  { brand: "3.Paradis SS25",            season: "PFW 2025" },
  { brand: "Vivienne Westwood AW25",    season: "PFW 2025" },
  { brand: "Rhude AW24",                season: "NYFW 2024" },
];
---

<Layout title="Runway Shows — Estelle Sweeney">
  <div class="min-h-screen bg-black text-cream">

    <nav class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <a href="/" class="text-sm font-semibold tracking-[0.2em] uppercase font-display hover:opacity-50 transition-opacity">Estelle Sweeney</a>
      <a href="mailto:estellescreative@gmail.com" class="text-xs tracking-[0.15em] uppercase font-display hover:opacity-50 transition-opacity">Contact</a>
    </nav>

    <main class="px-6 py-12 max-w-7xl mx-auto">

      <div class="flex items-baseline justify-between border-b border-white/10 pb-6 mb-12">
        <h1 class="text-xs tracking-[0.3em] uppercase font-display">Runway</h1>
        <a href="/runway" class="text-[10px] tracking-[0.2em] uppercase text-white/30 hover:text-white/60 transition-colors font-display">← Back</a>
      </div>

      {/* Shows with galleries */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-14 mb-20">
        {galleryShows.map((show) => (
          <a href={`/runway/${show.slug}`} class="group flex flex-col gap-0 cursor-pointer">
            <div class="w-full overflow-hidden aspect-[4/3] bg-white/5">
              <img
                src={show.cover}
                alt={show.brand}
                class="w-full h-full object-cover transition-opacity duration-500 group-hover:opacity-75"
                loading="lazy"
              />
            </div>
            <div class="pt-4 flex flex-col gap-1 border-t border-white/10 mt-0">
              <span class="text-sm tracking-[0.05em] font-display group-hover:opacity-60 transition-opacity">{show.brand}</span>
              <span class="text-xs tracking-[0.15em] uppercase text-white/40">{show.season}</span>
            </div>
          </a>
        ))}
      </div>

      {/* Divider */}
      {textOnlyShows.length > 0 && (
        <div class="border-t border-white/10 pt-12 mb-12">
          <h2 class="text-[10px] tracking-[0.3em] uppercase text-white/25 font-display mb-10">Additional Credits</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-8">
            {textOnlyShows.map((show) => (
              <div class="flex flex-col gap-1 border-t border-white/10 pt-5">
                <span class="text-sm tracking-[0.05em] font-display text-white/60">{show.brand}</span>
                <span class="text-xs tracking-[0.15em] uppercase text-white/25">{show.season}</span>
              </div>
            ))}
          </div>
        </div>
      )}

    </main>
  </div>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import GalleryLightbox from "@/components/GalleryLightbox";
import { CAMPAIGN_PROJECTS } from "@/data/campaigns";

export function getStaticPaths() {
  return CAMPAIGN_PROJECTS.map((p, i) => ({
    params: { project: p.slug },
    props: {
      project: p,
      next: CAMPAIGN_PROJECTS[(i + 1) % CAMPAIGN_PROJECTS.length],
    },
  }));
}

const { project, next } = Astro.props;
---

<Layout title={`${project.name} — Campaigns — Estelle Sweeney`}>
  <div class="min-h-screen bg-black text-white font-sans">

    {project.images.length > 0 ? (
      /* ── Gallery view ─────────────────────────────────────────── */
      <div class="min-h-screen">
        <nav class="flex items-center justify-between px-6 py-5 border-b border-white/10">
          <a href="/campaigns" class="text-xs tracking-[0.18em] uppercase font-display text-white/50 hover:text-white transition-colors">
            ← Campaigns
          </a>
          <span class="text-xs tracking-[0.18em] uppercase font-display text-white/40">{project.name}</span>
          <a href={`/campaigns/${next.slug}`} class="text-xs tracking-[0.18em] uppercase font-display text-white/50 hover:text-white transition-colors">
            {next.short} →
          </a>
        </nav>
        <main class="px-4 py-8 max-w-6xl mx-auto">
          <GalleryLightbox images={project.images} alt={project.name} client:load />
        </main>
      </div>
    ) : (
      /* ── Coming soon ──────────────────────────────────────────── */
      <div style="position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;background:#060606;">
        {project.cover && (
          <img
            src={project.cover}
            alt={project.name}
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;filter:grayscale(20%) brightness(0.3);"
            onerror="this.style.display='none'"
          />
        )}
        <div style="position:relative;z-index:2;text-align:center;padding:40px;">
          <p style="font-family:monospace;font-size:8px;letter-spacing:0.3em;text-transform:uppercase;color:rgba(255,106,26,0.5);margin-bottom:12px;">
            Campaign Archive · {project.year ?? ""}
          </p>
          <p style="font-family:'Bodoni Moda',serif;font-size:clamp(28px,5vw,52px);color:rgba(255,255,255,0.85);margin-bottom:8px;letter-spacing:0.03em;">
            {project.name}
          </p>
          <p style="font-family:'Bodoni Moda',serif;font-size:clamp(13px,2vw,18px);color:rgba(255,255,255,0.25);margin-bottom:36px;letter-spacing:0.08em;">
            Gallery coming soon
          </p>
          <div style="display:flex;justify-content:center;gap:32px;flex-wrap:wrap;">
            <a href="/campaigns" style="font-family:monospace;font-size:8px;letter-spacing:0.25em;text-transform:uppercase;color:rgba(255,255,255,0.35);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='rgba(255,106,26,0.8)'" onmouseout="this.style.color='rgba(255,255,255,0.35)'">
              ← Back to Campaigns
            </a>
            <a href={`/campaigns/${next.slug}`} style="font-family:monospace;font-size:8px;letter-spacing:0.25em;text-transform:uppercase;color:rgba(255,255,255,0.35);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='rgba(255,106,26,0.8)'" onmouseout="this.style.color='rgba(255,255,255,0.35)'">
              {next.short} →
            </a>
          </div>
        </div>
      </div>
    )}

  </div>
</Layout>

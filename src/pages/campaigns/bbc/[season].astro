---
import Layout from "@/layouts/Layout.astro";
import GalleryLightbox from "@/components/GalleryLightbox";
import { CAMPAIGN_PROJECTS } from "@/data/campaigns";

const bbc = CAMPAIGN_PROJECTS.find((p) => p.slug === "bbc")!;
const subs = bbc.subcampaigns ?? [];

export function getStaticPaths() {
  const bbc = CAMPAIGN_PROJECTS.find((p) => p.slug === "bbc")!;
  return (bbc.subcampaigns ?? []).map((sub, i) => ({
    params: { season: sub.slug },
    props: {
      sub,
      next: (bbc.subcampaigns ?? [])[(i + 1) % (bbc.subcampaigns?.length ?? 1)],
    },
  }));
}

const { sub, next } = Astro.props;
---

<Layout title={`BBC ${sub.name} — Campaigns — Estelle Sweeney`}>
  <div class="min-h-screen bg-black text-white font-sans">

    {sub.images.length > 0 ? (
      /* ── Gallery ──────────────────────────────────────────────── */
      <div class="min-h-screen">
        <nav class="flex items-center justify-between px-6 py-5 border-b border-white/10">
          <a href="/campaigns/bbc" class="text-xs tracking-[0.18em] uppercase font-display text-white/50 hover:text-white transition-colors">
            &larr; BBC
          </a>
          <span class="text-xs tracking-[0.18em] uppercase font-display text-white/40">
            {sub.name}
          </span>
          <a href={`/campaigns/bbc/${next.slug}`} class="text-xs tracking-[0.18em] uppercase font-display text-white/50 hover:text-white transition-colors">
            {next.name} &rarr;
          </a>
        </nav>
        <main class="px-4 py-8 max-w-6xl mx-auto">
          <GalleryLightbox images={sub.images} alt={`BBC ${sub.name}`} client:load />
        </main>
      </div>

    ) : (
      /* ── Coming soon ──────────────────────────────────────────── */
      <div style="position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#060606;">
        {sub.cover && (
          <img
            src={sub.cover}
            alt={sub.name}
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(20%) brightness(0.28);"
            onerror="this.style.display='none'"
          />
        )}
        <div style="position:relative;z-index:2;text-align:center;padding:40px;">
          <p style="font-family:monospace;font-size:8px;letter-spacing:0.3em;text-transform:uppercase;color:rgba(255,106,26,0.5);margin-bottom:12px;">
            Billionaire Boys Club · {sub.year ?? ""}
          </p>
          <p style="font-family:'Bodoni Moda',serif;font-size:clamp(28px,5vw,52px);color:rgba(255,255,255,0.85);margin-bottom:8px;letter-spacing:0.03em;">
            {sub.name}
          </p>
          <p style="font-family:'Bodoni Moda',serif;font-size:clamp(13px,2vw,18px);color:rgba(255,255,255,0.25);margin-bottom:36px;letter-spacing:0.08em;">
            Gallery coming soon
          </p>
          <div style="display:flex;justify-content:center;gap:32px;flex-wrap:wrap;">
            <a href="/campaigns/bbc" style="font-family:monospace;font-size:8px;letter-spacing:0.25em;text-transform:uppercase;color:rgba(255,255,255,0.35);text-decoration:none;">
              &larr; Back to BBC
            </a>
            <a href={`/campaigns/bbc/${next.slug}`} style="font-family:monospace;font-size:8px;letter-spacing:0.25em;text-transform:uppercase;color:rgba(255,255,255,0.35);text-decoration:none;">
              {next.name} &rarr;
            </a>
          </div>
        </div>
      </div>
    )}

  </div>
</Layout>

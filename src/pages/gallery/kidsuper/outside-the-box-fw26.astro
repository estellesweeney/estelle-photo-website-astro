---
import Layout from "@/layouts/Layout.astro";
import RunwayGalleryGrid from "@/components/RunwayGalleryGrid";

const images = [
  "/slides/kidsuper/otb-01.jpg",
  "/slides/kidsuper/otb-02.jpg",
  "/slides/kidsuper/otb-03.jpg",
  "/slides/kidsuper/otb-04.jpg",
  "/slides/kidsuper/otb-05.jpg",
  "/slides/kidsuper/otb-06.jpg",
  "/slides/kidsuper/otb-07.jpg",
  "/slides/kidsuper/otb-08.jpg",
  "/slides/kidsuper/otb-09.jpg",
  "/slides/kidsuper/otb-10.jpg",
];
---

<Layout title='"Outside the Box" F/W 26 — KidSuper — Estelle Sweeney'>
  <div class="min-h-screen bg-black text-cream">

    <nav class="flex items-center justify-between px-8 py-6 border-b border-white/10">
      <a href="/" class="text-sm font-semibold tracking-[0.2em] uppercase font-display hover:opacity-50 transition-opacity">Estelle Sweeney</a>
      <a href="mailto:estellescreative@gmail.com" class="text-xs tracking-[0.15em] uppercase font-display hover:opacity-50 transition-opacity">Contact</a>
    </nav>

    <main class="px-8 py-14 max-w-screen-xl mx-auto">
      <div class="mb-14 pb-6 border-b border-white/10 flex items-baseline justify-between">
        <div class="flex flex-col gap-2">
          <a href="/gallery/kidsuper" class="text-[10px] tracking-[0.2em] uppercase text-white/30 hover:text-white/60 transition-colors font-display">← KidSuper</a>
          <h1 class="text-base font-display tracking-wide">"Outside the Box"</h1>
        </div>
        <span class="text-xs tracking-[0.2em] uppercase text-white/30" style="font-family: Arial, sans-serif;">F/W 26</span>
      </div>

      <RunwayGalleryGrid images={images} brand="KidSuper" client:load />
    </main>

  </div>
</Layout>

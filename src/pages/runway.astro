---
import HomeIcon from '@/components/HomeIcon.astro';
import Layout from "@/layouts/Layout.astro";
import { runwayShows } from "@/data/runway";

// Build a slug lookup so we know which shows have gallery pages
const slugMap = new Map(runwayShows.map(s => [s.brand, s.slug]));

const clients = [
  { name: "Walter Van Bierendonck", year: "2026" },
  { name: "KidSuper AW26/27", year: "2026" },
  { name: "Science Project", year: "2026" },
  { name: "Campillo AW26/27", year: "2026" },
  { name: "Yuima Nakazato", year: "2026" },
  { name: "Grace Ling AW26", year: "2026" },
  { name: "KidSuper AW25", year: "2024" },
  { name: "Mugler AW25", year: "2024" },
  { name: "Rick Owens SS24", year: "2024" },
  { name: "Mugler SS24", year: "2024" },
  { name: "Louis De Javier AW25", year: "2024" },
  { name: "Tombogo AW25", year: "2025" },
  { name: "Ruibuilt AW25", year: "2024" },
  { name: "Paula Casanova Del Vas AW25", year: "2024" },
  { name: "Hold NYC AW25", year: "2024" },
  { name: "Franck Sorbier — Couture", year: "2024" },
  { name: "Namesak3 SS26", year: "2025" },
  { name: "3.Paradis SS25", year: "2025" },
  { name: "Vivienne Westwood AW25", year: "2024" },
  { name: "Rhude AW24", year: "2025" },
];
---

<Layout title="Runway — Estelle Sweeney">
  <div class="min-h-screen bg-black text-cream" style="font-family: Arial, sans-serif;">

    <nav class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <HomeIcon />
      <a href="mailto:estellescreative@gmail.com" class="text-xs tracking-[0.15em] uppercase font-display hover:opacity-50 transition-opacity">Contact</a>
    </nav>

    <header class="flex items-center justify-center px-6 py-5 border-b border-white/10">
      <h1 class="text-xs tracking-[0.15em] uppercase font-display" style="font-family: 'Bodoni Moda', serif; font-weight: normal;">35mm Runway Photography</h1>
    </header>

    <main class="max-w-2xl mx-auto px-6 py-10">

      <div>
        <ul class="divide-y divide-white/10">
          {clients.map((c) => {
            const slug = slugMap.get(c.name);
            return (
              <li class="py-3 group">
                {slug ? (
                  <a
                    href={`/runway/${slug}`}
                    class="runway-link text-xs text-white/60 hover:text-white transition-colors duration-200 tracking-wide"
                  >
                    <span class="runway-link-text">{c.name}</span>
                    <span class="runway-link-arrow">↗</span>
                  </a>
                ) : (
                  <span class="text-xs text-white/30 tracking-wide">{c.name}</span>
                )}
                <div class="text-[9px] text-white/25 mt-0.5">{c.year}</div>
              </li>
            );
          })}
        </ul>
        <p class="mt-10 text-[9px] tracking-[0.2em] uppercase text-white/20">
          Highlighted shows have galleries →
        </p>
      </div>



    </main>

  </div>
<style>
  .runway-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.2s, border-color 0.2s;
  }
  .runway-link:hover {
    border-bottom-color: rgba(245, 240, 232, 0.5);
  }
  .runway-link-arrow {
    font-size: 11px;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .runway-link:hover .runway-link-arrow {
    opacity: 0.6;
    transform: translateX(0);
  }
</style>

</Layout>
